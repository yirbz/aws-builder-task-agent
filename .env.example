# ═══════════════════════════════════════════════════════════════════════
# AWS Builder Center — Login Credentials
# ═══════════════════════════════════════════════════════════════════════
# Used for automated re-authentication when sessions expire.
# This file is gitignored (*.env) — it never leaves your machine.
#
# Fill in your AWS Builder ID email and password below:
AWS_BUILDER_EMAIL=your_email@example.com
AWS_BUILDER_PASSWORD=your_password

# ═══════════════════════════════════════════════════════════════════════
# Gemini AI Configuration (Comments Engine)
# ═══════════════════════════════════════════════════════════════════════
# Get your free Gemini API key from: https://aistudio.google.com/app/apikey
STREAK_COMMENTS__GEMINI_API_KEY=your_gemini_api_key_here

# Model name to use (e.g. gemini-2.0-flash, gemini-2.5-flash, gemini-1.5-flash)
STREAK_COMMENTS__GEMINI_MODEL=gemini-2.0-flash

# (Optional: Shorter environment variable aliases)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.0-flash

# ═══════════════════════════════════════════════════════════════════════
# Notifications (Telegram & Discord)
# ═══════════════════════════════════════════════════════════════════════
STREAK_NOTIFICATIONS__TELEGRAM__ENABLED=false
STREAK_NOTIFICATIONS__TELEGRAM__BOT_TOKEN=
STREAK_NOTIFICATIONS__TELEGRAM__CHAT_ID=

STREAK_NOTIFICATIONS__DISCORD__ENABLED=false
STREAK_NOTIFICATIONS__DISCORD__WEBHOOK_URL=
